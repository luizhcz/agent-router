# Copie para .env (cp .env.example .env). O .env é gitignored.
ENV=mock
HTTP_PORT=8080

# LLM real (opcional). SEM estes, o app usa o mock em src/mock/llm-service.js.
# Preencha para usar o LLM de verdade — NUNCA comite o .env com credenciais.
# LLM_ENDPOINT=
# LLM_TOKEN=
# LLM_MODEL=gpt-5-mini
# LLM_TEMPERATURE=0.5

# Router de intenções (opcional; defaults resolvem sozinhos)
# ROUTER_MODELS_DIR=../../../models
# ROUTER_CACHE_DIR=
