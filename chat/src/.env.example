# Copie para .env (cp .env.example .env). O .env é gitignored.
ENV=mock
HTTP_PORT=8080

# LLM real (opcional). SEM estes, o app usa o mock em src/mock/llm-service.js.
# Preencha para usar o LLM de verdade — NUNCA comite o .env com credenciais.
# LLM_ENDPOINT=
# LLM_TOKEN=
# LLM_MODEL=gpt-5-mini
# LLM_TEMPERATURE=0.5

# Router de intenções (opcional; defaults resolvem sozinhos)
# ROUTER_MODELS_DIR=../../../models
# ROUTER_CACHE_DIR=

# Registro de conversa + KPIs: write-through Postgres (durável) + Redis (cache quente).
# COM estas variáveis => usa Postgres/Redis REAIS. SEM elas => mocks in-memory.
# A infra local sobe com `docker compose up -d` (chat/docker-compose.yml), nas portas abaixo.
DB_CONVERSATION_CONNECTION=postgres://chat:chatpw@localhost:5442/chat
REDIS_CONVERSATION_ENDPOINT=redis://localhost:6389
# PG_MOCK_LOG=1   # (só no mock) loga cada SQL emitida
