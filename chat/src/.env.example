# Copie para .env (cp .env.example .env). O .env é gitignored.
ENV=mock
HTTP_PORT=8080

# LLM real (opcional). SEM estes, o app usa o mock em src/mock/llm-service.js.
# Preencha para usar o LLM de verdade — NUNCA comite o .env com credenciais.
# LLM_ENDPOINT=
# LLM_TOKEN=
# LLM_MODEL=gpt-5-mini
# LLM_TEMPERATURE=0.5

# Router de intenções (opcional; defaults resolvem sozinhos)
# ROUTER_MODELS_DIR=../../../models
# ROUTER_CACHE_DIR=

# Registro de conversa: write-through Postgres (durável) + Redis (cache quente).
# Sem endpoints, os mocks in-memory assumem (src/mock/postgres-client.js, redis-client.js).
# DB_CONVERSATION_CONNECTION=postgres://user:pass@localhost:5432/chat
# REDIS_CONVERSATION_ENDPOINT=redis://localhost:6379
# PG_MOCK_LOG=1   # loga cada SQL emitida ao mock de Postgres
